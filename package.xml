<?xml version="1.0"?>
<package format="3">
  <name>radarays_gazebo_plugins</name>
  <version>0.0.0</version>
  <description>ROS 2 / Gazebo Harmonic migration package for radarays_gazebo_plugins.</description>

  <maintainer email="amock@uos.de">Alexander Mock</maintainer>
  <!-- Independent ROS 2 Jazzy / Gazebo Harmonic continuation, not affiliated
       with the original maintainer above. See README.md's "Origin" section. -->
  <maintainer email="s.aspragkathos@gmail.com">Sotiris Aspragkathos</maintainer>
  <license>BSD-3-Clause</license>

  <url type="repository">https://github.com/sotomotocross/radarays_gazebo_plugins</url>

  <author email="amock@uos.de">Alexander Mock</author>
  <author email="s.aspragkathos@gmail.com">Sotiris Aspragkathos</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>ros_gz_sim</depend>
  <depend>rmagine_gazebo_plugins</depend>
  <depend>radarays_ros</depend>
  <depend>rmagine</depend>
  <depend>sensor_msgs</depend>
  <!-- sensor_msgs_py: scripts/radarays_fixture_harness.py imports
       sensor_msgs_py.point_cloud2; was working transitively (already
       installed for another reason on this dev machine) but not declared,
       flagged in self-review. A fresh/minimal environment shouldn't have
       to rely on that. -->
  <depend>sensor_msgs_py</depend>
  <!-- ros_gz_bridge: rmagine_gazebo_plugins's sensor systems publish
       radar/scan+radar/points over native gz-transport only (post
       amock-rewrite), not rclcpp directly. The fixture harness and all
       3 interactive launch files run a ros_gz_bridge parameter_bridge to
       get them into ROS 2. radar/image needs no bridge (this package's
       own plugin, still an embedded rclcpp publisher). -->
  <depend>ros_gz_bridge</depend>
  <depend>gz-sim8</depend>
  <depend>gz-plugin2</depend>
  <depend>gz-transport13</depend>
  <depend>gz-common5</depend>
  <depend>gz-math7</depend>
  <depend>gz-msgs10</depend>
  <depend>gz-rendering8</depend>
  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
